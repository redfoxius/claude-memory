{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/claude-memory/user-prompt-submit.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/prompt-logger"
          },
          {
            "type": "command",
            "command": "/Users/owner/.claude/hooks/claude-memory/user-prompt-submit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.claude/hooks/claude-memory/session-end.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
