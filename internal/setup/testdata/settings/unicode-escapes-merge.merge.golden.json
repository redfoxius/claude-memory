{
  "statusLine": "caf\u00e9 \/ x \"quoted\" <b>&amp;</b>",
  "env": {
    "GREETING": "\u4f60\u597d\n"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.claude/hooks/claude-memory/user-prompt-submit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.claude/hooks/claude-memory/session-end.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
