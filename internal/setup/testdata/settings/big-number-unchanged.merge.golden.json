{
  "cleanupPeriodDays": 12345678901234567890,
  "ratio": 1.50,
  "exp": 1E+400,
  "neg": -0,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.claude/hooks/claude-memory/user-prompt-submit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/owner/.claude/hooks/claude-memory/session-end.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
