<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.claude-memory.cleanup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/test/.local/bin/claude-memory</string>
		<string>cleanup</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/Users/test/.volta/bin:/usr/bin:/bin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>15</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/test/.local/state/claude-memory/cleanup.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/test/.local/state/claude-memory/cleanup.log</string>
</dict>
</plist>
