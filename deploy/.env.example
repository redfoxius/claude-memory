# Copy to deploy/.env on the server, fill in, then: chmod 600 .env
# Never commit the real .env.

# The server's Tailscale IPv4 (`tailscale ip -4`).
POSTGRES_BIND_IP=100.64.0.10

# Superuser password (admin only; laptops never use it). `openssl rand -base64 32`
POSTGRES_PASSWORD=change-me

# Application role used by the laptop's claude-memory. `openssl rand -base64 32`
APP_DB_NAME=claude_memory
APP_DB_USER=claude_memory
APP_DB_PASSWORD=change-me
