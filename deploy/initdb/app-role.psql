-- Creates the application role and database and enables pgvector, idempotently.
--
-- One source for two callers: deploy/initdb/01-app-role.sh (the Docker server
-- stack) runs this file with `psql -v app_user=... -v app_db=... -v app_pw=...`,
-- and `claude-memory install` renders bootstrap.sql as three `\set` lines for
-- those variables followed by this file verbatim.
--
-- Run it as a Postgres superuser against the `postgres` database. It is safe
-- to run twice: an existing role keeps its password, an existing database
-- keeps its owner and contents.
--
-- Variables: app_user and app_db are used as identifiers (:"app_user"), app_pw
-- as a string literal (:'app_pw'). psql does not interpolate variables inside
-- $$ bodies, which rules out DO blocks, so idempotency comes from \gexec.

\set ON_ERROR_STOP on

-- Refuse the reserved databases: the REVOKE below would take PUBLIC's
-- privileges away on `postgres` or a template, which the server itself uses.
SELECT :'app_db' IN ('postgres', 'template0', 'template1') AS app_db_reserved \gset
\if :app_db_reserved
  \echo 'refusing to use a reserved database name (postgres, template0, template1) as app_db'
  SELECT 1/0;
\endif

-- The app role is not a superuser.
SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'app_user', :'app_pw')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'app_user')
\gexec

-- CREATE DATABASE cannot run inside a function or DO block.
SELECT format('CREATE DATABASE %I OWNER %I', :'app_db', :'app_user')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'app_db')
\gexec

REVOKE ALL ON DATABASE :"app_db" FROM PUBLIC;

\connect :"app_db"

-- pgvector is not a trusted extension, so the app role cannot create it.
CREATE EXTENSION IF NOT EXISTS vector;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT ALL ON SCHEMA public TO :"app_user";
